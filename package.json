{
  "name": "@socialize/react-native-meteor",
  "version": "4.0.0-alpha.5",
  "description": "Full Meteor Client for React Native",
  "type": "commonjs",
  "license": "MIT",
  "author": "Kelly Copley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copleykj/react-native-meteor.git"
  },
  "bugs": {
    "url": "https://github.com/copleykj/react-native-meteor/issues"
  },
  "homepage": "https://github.com/copleykj/react-native-meteor#readme",
  "keywords": [
    "ddp",
    "meteor",
    "react",
    "react-native",
    "ios",
    "android"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "node node_modules/ts7/bin/tsc --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint && attw --pack .",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "ejson": "^2.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.31.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "mock-socket": "^9.3.1",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "ts7": "npm:typescript@^7.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
