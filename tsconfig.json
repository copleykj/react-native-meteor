{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "types": ["vitest/globals"]
    },
    "include": ["src", "test", "types", "tsup.config.ts", "vitest.config.ts"]
}
